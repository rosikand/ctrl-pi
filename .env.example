# Backend configuration. Keep the real .env local and gitignored.
CTRL_PI_ENV=development
CTRL_PI_API_HOST=127.0.0.1
CTRL_PI_API_PORT=8000
CTRL_PI_YAM_DRIVER=mock

# Ordinary PostgreSQL. Supabase is an optional hosted provider.
DATABASE_URL=postgresql+psycopg://ctrl_pi:change-me@localhost:5432/ctrl_pi

# Server-side only. Never prefix secrets with VITE_ or expose them to frontend code.
HF_TOKEN=
HF_NAMESPACE=

# Modal uses its normal local profile/configuration. Lambda uses SSH agent/config.
